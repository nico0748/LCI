{
  "name": "lci",
  "private": true,
  "version": "0.1.0",
  "description": "Live Coding Interview trainer — 説明しながらコーディングする面接の練習アプリ",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @lci/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "problems:validate": "pnpm --filter @lci/problem-tools validate",
    "problems:stats": "pnpm --filter @lci/problem-tools stats",
    "problems:selftest": "pnpm --filter @lci/problem-tools selftest",
    "mcp": "pnpm --filter @lci/mcp-server start",
    "runner:build": "docker compose -f docker/docker-compose.yml build",
    "runner:warm": "node --experimental-strip-types --no-warnings packages/runner/src/cli.ts warm",
    "runner:status": "node --experimental-strip-types --no-warnings packages/runner/src/cli.ts status",
    "runner:bench": "node --experimental-strip-types --no-warnings packages/runner/src/cli.ts bench"
  },
  "engines": {
    "node": ">=22"
  }
}
