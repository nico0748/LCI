{
  "kind": "unit",
  "limits": { "timeMs": 3000, "wallMs": 10000, "memoryMb": 256 },
  "harness": {
    "python": { "files": ["tests/python/test_units.py"], "command": "python3 -I -m unittest discover -v -s . -p test_units.py", "resultParser": "unittest-verbose" },
    "typescript": { "files": ["tests/typescript/units.test.ts"], "command": "node --experimental-strip-types --no-warnings --test --test-reporter=tap units.test.ts", "resultParser": "tap" }
  },
  "userEntry": { "python": "units.py", "typescript": "units.ts" }
}
