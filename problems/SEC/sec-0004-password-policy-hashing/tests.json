{
  "kind": "unit",
  "limits": { "timeMs": 8000, "wallMs": 20000, "memoryMb": 256 },
  "harness": {
    "python": { "files": ["tests/python/test_password.py"], "command": "python3 -I -m unittest discover -v -s . -p test_password.py", "resultParser": "unittest-verbose" },
