{
  "name": "@lci/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node --experimental-strip-types --no-warnings scripts/check-contrast.mjs",
    "sandbox:tailwind": "cp node_modules/@tailwindcss/browser/dist/index.global.js public/sandbox/tailwind.js",
    "test": "node --experimental-strip-types --test \"src/lib/**/*.test.ts\" \"src/components/ui/**/*.test.ts\" \"src/components/layout/**/*.test.ts\" \"src/components/review/**/*.test.ts\" \"src/components/session/**/*.test.ts\" \"src/app/**/*.test.ts\"",
    "monaco:local": "rm -rf public/monaco && mkdir -p public/monaco && cp -R node_modules/monaco-editor/min/vs public/monaco/vs",
    "postinstall": "pnpm run monaco:local"
  },
  "dependencies": {
    "@lci/core": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "@lci/evaluator": "workspace:*",
    "@lci/runner": "workspace:*",
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
